# ─────────────────────────────────────────────────────────────
# WireDots environment variables
# Copy this file to `.env.local` and fill in your Supabase values.
# NEVER commit `.env.local`. No secrets are hardcoded anywhere.
# ─────────────────────────────────────────────────────────────

# Public — safe to expose to the browser (used by client + server)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only — NEVER expose to the browser.
# Used exclusively by the seed script (supabase/seed.mjs) to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
